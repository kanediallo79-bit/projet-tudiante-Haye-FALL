services:
  openbao:
    image: quay.io/openbao/openbao:latest
    container_name: openbao
    restart: always
    ports:
      - "8200:8200"
    environment:
      BAO_DEV_ROOT_TOKEN_ID: "root-token-2026"
      BAO_DEV_LISTEN_ADDRESS: "0.0.0.0:8200"
    cap_add:
      - IPC_LOCK
    command: server -dev

networks:
  default:
